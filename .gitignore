build/
dist/
wheels/
*.egg-info/

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# =========================
# Virtual environments
# =========================
.venv/
venv/
env/

